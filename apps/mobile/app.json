{
  "expo": {
    "name": "Korb",
    "slug": "korb",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "korb",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.korb.mobile",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.korb.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2E7442",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E7442",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128,
          "dark": {
            "backgroundColor": "#0E120C",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 128
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Korb uses the camera to read the barcode on your loyalty card. The image is never saved or uploaded.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Korb needs access to your photos so you can add a loyalty card from a screenshot.",
          "microphonePermission": false
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b4e2d2af-f8e2-4ac2-9d47-e8576727dc25"
      }
    },
    "owner": "sonuyou19s-team",
    "updates": {
      "url": "https://u.expo.dev/b4e2d2af-f8e2-4ac2-9d47-e8576727dc25"
    }
  }
}
